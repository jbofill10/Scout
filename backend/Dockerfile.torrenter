# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache build-base

# Copy go.mod and go.sum for dependency caching
COPY go.mod go.sum ./

# Download dependencies (cached layer)
RUN go mod download

# Copy shared packages
COPY pkg/ ./pkg/

# Copy torrenter service code
COPY cmd/torrenter/ ./cmd/torrenter/
COPY internal/torrenter/ ./internal/torrenter/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o torrenter ./cmd/torrenter

# Runtime stage
FROM alpine:3.19

# Runtime deps
RUN apk --no-cache add ca-certificates tzdata wget

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/torrenter .

# Expose port
EXPOSE 22001

# Run the binary
CMD ["./torrenter"]
