# Scout Docker-Compose Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env should be added to .gitignore (never commit secrets!)

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_NAME=scoutdb
DB_USER=scoutuser
DB_PASSWORD=CHANGE_ME_database_password

# ============================================================================
# TVDB API Configuration
# Get your API key from https://thetvdb.com/api-information (PIN is for subscriber accounts)
# ============================================================================
TVDB_HOST=https://api4.thetvdb.com/v4
TVDB_API_KEY=CHANGE_ME_your_tvdb_api_key
TVDB_PIN=CHANGE_ME_your_tvdb_subscriber_pin

# ============================================================================
# Download defaults (torrenter). Every value here is only the default: the
# Settings page in the UI can override it at runtime without a restart.
# ============================================================================
# Lowest resolution Scout will accept: 480p, 720p, 1080p or 2160p
MIN_QUALITY=1080p
# Gigabytes kept free on the downloads volume; a release that would eat into it is not started
MIN_FREE_SPACE_GB=10
# Quality upgrades: replace library copies below UPGRADE_CUTOFF, UPGRADE_BATCH per pass, every UPGRADE_CHECK_INTERVAL
UPGRADES_ENABLED=false
UPGRADE_CUTOFF=1080p
UPGRADE_BATCH=3
UPGRADE_CHECK_INTERVAL=6h

# ============================================================================
# Prowlarr Configuration
# Prowlarr indexes torrent sites (NYAA, 1337x, etc.)
# ============================================================================
PROWLARR_HOST=http://host.docker.internal:9696
PROWLARR_KEY=CHANGE_ME_your_prowlarr_api_key

# ============================================================================
# qBittorrent Configuration
# qBittorrent is the torrent client that downloads media
# ============================================================================
QBITT_HOST=http://host.docker.internal:8080
QBITT_USER=CHANGE_ME_your_qbittorrent_username
QBITT_PASSWORD=CHANGE_ME_your_qbittorrent_password

# ============================================================================
# Plex Media Server Configuration
# Plex hosts your media library
# ============================================================================
PLEX_HOST=http://host.docker.internal:32400
PLEX_KEY=CHANGE_ME_your_plex_token
PLEX_MOVIE_SECTIONS=3
PLEX_SHOW_SECTIONS=4
# How the torrenter keeps its database copy of the Plex library current:
# re-read it this long after the last download landed, and on this interval (0 disables)
PLEX_SYNC_DELAY=2m
PLEX_SYNC_INTERVAL=30m

# ============================================================================
# OpenTelemetry Configuration
# Distributed tracing endpoint (SignOz or other OTLP-compatible collector)
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# ============================================================================
# TVDB Refresh Configuration
# Periodic refresh of episode metadata for shows in Plex library
# ============================================================================
WEBSERVER_HOST=http://webserver:22920
TVDB_REFRESH_INTERVAL=6h
# How often the webserver re-checks followed shows for new episodes
FOLLOW_CHECK_INTERVAL=6h

# ============================================================================
# Notes:
# ============================================================================
# 1. host.docker.internal: Used to access services running on your host machine
#    from within Docker containers. If this doesn't work on Linux, you may need
#    to use your actual LAN IP (e.g., 192.168.x.x) instead.
#
# 2. PLEX_MOVIE_SECTIONS and PLEX_SHOW_SECTIONS: These are Plex library section
#    IDs. You can find them by going to your Plex libraries and looking at the
#    URL. For example: http://localhost:32400/web/index.html#!/media/.../com.plexapp.plugins.library?source=3
#    The number at the end (3) is the section ID.
#
# 3. To get your Plex token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
#
# 4. The /data/Downloads and /data/Media directories must exist on your host
#    machine and be accessible by both qBittorrent and the Scout containers.

# Subtitles (torrenter, optional). Free API key + account: https://www.opensubtitles.com/consumers
# Leave OPENSUBTITLES_API_KEY empty to disable subtitle fetching.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBTITLE_LANGUAGES=en
SUBTITLE_PREFER_SDH=false

# Host relay agent (tools/relay-agent/README.md). When set, the torrenter rotates
# the Mullvad relay when an indexer blocks the exit IP and re-tests the indexer.
RELAY_AGENT_URL=
RELAY_AGENT_TOKEN=
RELAY_ROTATE_COOLDOWN=30m
